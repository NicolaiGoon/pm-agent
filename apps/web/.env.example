# Copy to apps/web/.env.local and fill in. It lives beside the Next app because
# Next loads .env.local from the app directory, not the monorepo root — a copy at
# the root is read by nothing. The orchestrator (T-202) starts inside this same
# Next process, so one file serves both. Git-ignored; never commit real values.
# Reference: LLD §11. Parsed and validated at boot by packages/domain/src/env.ts.

# --- Supabase (T-001, T-004) -------------------------------------------------
# Local stack: `pnpm db:start` prints these. Hosted: Supabase dashboard > API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Bypasses RLS — must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Model API (T-001) -------------------------------------------------------
# Set a monthly spend limit in the Anthropic console as a backstop to the
# in-app daily budget (settings.daily_budget_usd).
ANTHROPIC_API_KEY=

# --- GitHub App (T-203) ------------------------------------------------------
GITHUB_APP_ID=
# The .pem, base64-encoded so it fits on one line:
#   base64 -w0 your-app.private-key.pem
GITHUB_APP_PRIVATE_KEY=

# --- Orchestrator (T-202) ----------------------------------------------------
# Set false to run the UI without the worker loops (e.g. a second dev instance).
ORCHESTRATOR_ENABLED=true
# Identifies this worker in tasks.locked_by. Defaults to the hostname.
WORKER_ID=

# --- Sandbox (T-301, T-302) --------------------------------------------------
SANDBOX_IMAGE=pm-agent-sandbox:0.1.0

# --- Edge Function secrets (T-305) -------------------------------------------
# NOT read from this file. Set on the deployed function instead:
#   supabase secrets set GITHUB_WEBHOOK_SECRET=...
# SUPABASE_SERVICE_ROLE_KEY is provided to functions automatically.
# GITHUB_WEBHOOK_SECRET=
