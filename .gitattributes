# Normalise to LF in the repository. CI runs on Linux and the implementation
# sandbox is a Linux container, so CRLF leaking in breaks shell scripts and
# makes diffs noisy on a Windows dev machine.
* text=auto eol=lf

# Never touch these.
*.png   binary
*.jpg   binary
*.ico   binary
*.pem   binary
*.patch -text

# Generated — collapse in diffs and reviews.
pnpm-lock.yaml          linguist-generated=true -diff
packages/db/src/database.types.ts linguist-generated=true
